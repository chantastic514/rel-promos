<!-- MODAL 1: DÉTAIL D'OFFRE & CODE PROMO (Accessible, Clôturable) -->
<div class="fixed inset-0 z-50 hidden bg-inverse-surface/60 backdrop-blur-sm flex items-center justify-center p-space-md" id="offerModal">
<div class="bg-surface-card rounded-2xl max-w-lg w-full p-space-lg shadow-2xl relative flex flex-col gap-space-md animate-in fade-in zoom-in duration-200">
<button aria-label="Fermer la fenêtre" class="absolute top-space-md right-space-md w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high" onclick="closeOfferModal()">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
<div class="flex items-center gap-space-xs">
<span class="w-3 h-3 rounded-full bg-secondary-container"></span>
<span class="font-label-md text-label-md text-primary font-bold" id="modalRestaurant">Restaurant</span>
</div>
<div>
<span class="inline-block px-space-sm py-1 rounded-md bg-secondary-container text-on-primary font-display-lg text-[20px] font-extrabold tracking-tight mb-space-xs" id="modalBadge">RABAIS</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface font-extrabold" id="modalTitle">Offre spéciale</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
          Présentez ce coupon numérique sur votre téléphone ou mentionnez ce code exclusif au serveur lors de votre commande.
        </p>
</div>
<!-- Coupon code clip box -->
<div class="bg-surface-container-low p-space-md rounded-xl flex items-center justify-between gap-space-sm">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">Ton code exclusif RestoEnLigne</span>
<span class="font-headline-md text-headline-md font-mono text-primary font-bold tracking-widest" id="modalCode">KINTON2X1</span>
</div>
<button class="px-space-md py-space-sm rounded-xl font-label-md text-label-md bg-primary text-on-primary font-bold hover:opacity-90 flex items-center gap-1 shadow-sm" id="copyBtn" onclick="copyPromoCode()">
<span class="material-symbols-outlined text-[16px]">content_copy</span>
<span id="copyBtnText" class="">Copier</span>
</button>
</div>
<div class="space-y-1 font-body-sm text-body-sm text-on-surface-variant">
<p class="flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-success-green">check</span>
          Valable immédiatement en salle à manger
        </p>
<p class="flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-success-green">check</span>
          Sans obligation d'impression papier
        </p>
</div>
<div class="pt-space-xs flex items-center justify-end gap-space-sm">
<button class="px-space-md py-space-sm rounded-xl font-label-md text-label-md bg-surface-container text-on-surface font-bold hover:bg-surface-container-high" onclick="closeOfferModal()">
          Fermer
        </button>
<button class="px-space-lg py-space-sm rounded-xl font-label-md text-label-md bg-secondary-container text-on-primary font-bold hover:opacity-95 shadow-sm flex items-center gap-1" onclick="bookTableDirect()">
