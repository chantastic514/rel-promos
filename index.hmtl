</button>
</div>
</div>
</div>
<!-- MODAL 2: TOUS LES FILTRES AVANCÉS -->
<div class="fixed inset-0 z-50 hidden bg-inverse-surface/60 backdrop-blur-sm flex items-center justify-center p-space-md" id="filterModal">
<div class="bg-surface-card rounded-2xl max-w-lg w-full p-space-lg shadow-2xl relative flex flex-col gap-space-md max-h-[921px] overflow-y-auto">
<div class="flex items-center justify-between pb-space-xs">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[24px]">tune</span>
<h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Filtres avancés</h3>
</div>
<button aria-label="Fermer" class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high" onclick="toggleFilterModal()">
<span class="material-symbols-outlined text-[20px]">close</span>
</button>
</div>
<!-- Distance Slider -->
<div>
<div class="flex justify-between items-center mb-1">
<label class="font-label-md text-label-md text-on-surface font-bold">Rayon de recherche maximal</label>
<span class="font-label-md text-label-md text-primary font-extrabold" id="radiusLabel">10 km</span>
</div>
<input class="w-full accent-primary cursor-pointer" max="50" min="1" oninput="document.getElementById('radiusLabel').innerText = this.value + ' km';" type="range" value="10">
<div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant">
<span class="">1 km</span>
<span class="">15 km</span>
<span class="">50 km</span>
</div>
</div>
<!-- Service mode -->
<div>
<label class="block font-label-md text-label-md text-on-surface font-bold mb-space-xs">Type de service</label>
<div class="grid grid-cols-3 gap-space-xs">
<button class="py-2 px-space-xs rounded-xl bg-primary text-on-primary font-label-sm text-label-sm font-bold text-center" onclick="this.classList.toggle('bg-primary'); this.classList.toggle('text-on-primary'); this.classList.toggle('bg-surface-container');" type="button">Sur place</button>
<button class="py-2 px-space-xs rounded-xl bg-surface-container text-on-surface font-label-sm text-label-sm font-bold text-center" onclick="this.classList.toggle('bg-primary'); this.classList.toggle('text-on-primary'); this.classList.toggle('bg-surface-container');" type="button">À emporter</button>
<button class="py-2 px-space-xs rounded-xl bg-surface-container text-on-surface font-label-sm text-label-sm font-bold text-center" onclick="this.classList.toggle('bg-primary'); this.classList.toggle('text-on-primary'); this.classList.toggle('bg-surface-container');" type="button">Livraison</button>
</div>
</div>
<!-- Cuisine Types -->
<div>
<label class="block font-label-md text-label-md text-on-surface font-bold mb-space-xs">Type de cuisine</label>
<div class="flex flex-wrap gap-space-xs">
<span class="px-space-sm py-1 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-semibold cursor-pointer">Tous</span>
<span class="px-space-sm py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold cursor-pointer hover:bg-surface-container-high">Japonais &amp; Ramen</span>
<span class="px-space-sm py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold cursor-pointer hover:bg-surface-container-high">Pizzas italiennes</span>
<span class="px-space-sm py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold cursor-pointer hover:bg-surface-container-high">Bistros &amp; Terroir</span>
<span class="px-space-sm py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold cursor-pointer hover:bg-surface-container-high">Brunch &amp; Déjeuner</span>
<span class="px-space-sm py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold cursor-pointer hover:bg-surface-container-high">Tavernes &amp; Bar à vin</span>
</div>
</div>
<!-- Price Range -->
<div>
<label class="block font-label-md text-label-md text-on-surface font-bold mb-space-xs">Fourchette de prix de l'offre</label>
<div class="grid grid-cols-4 gap-space-xs">
<button class="py-1.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-bold">$ (Moins de 15$)</button>
<button class="py-1.5 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md font-bold">$$ (15$ - 25$)</button>
<button class="py-1.5 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md font-bold">$$$ (25$ - 50$)</button>
<button class="py-1.5 rounded-lg bg-surface-container text-on-surface font-label-md text-label-md font-bold">$$$$ (50$+)</button>
</div>
</div>
<div class="pt-space-md flex items-center justify-between gap-space-sm">
<button class="font-label-md text-label-md text-on-surface-variant underline" onclick="toggleFilterModal()">
          Réinitialiser
        </button>
<button class="px-space-lg py-space-sm rounded-xl font-label-lg text-label-lg bg-secondary-container text-on-primary font-bold shadow-sm hover:opacity-95" onclick="toggleFilterModal(); showToast('Filtres appliqués avec succès');">
          Appliquer les filtres (48 résultats)
        </button>
</div>
</div>
</div>
<!-- TOAST NOTIFICATION CONTAINER -->
<div class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 bg-inverse-surface text-inverse-on-surface px-space-md py-space-sm rounded-xl shadow-xl flex items-center gap-space-xs font-label-md text-label-md" id="toastNotification">
<span class="material-symbols-outlined text-[20px] text-success-green">check_circle</span>
<span id="toastMessage" class="">Action confirmée</span>
</div>
<!-- INLINE CLIENT SCRIPT FOR SEAMLESS B2C MICRO-INTERACTIONS -->
<script>
    function showToast(message) {
      const toast = document.getElementById('toastNotification');
      const text = document.getElementById('toastMessage');
      if (toast && text) {
        text.innerText = message;
        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
          toast.classList.remove('translate-y-0', 'opacity-100');
        }, 3200);
      }
    }

    function toggleFav(btn) {
      const icon = btn.querySelector('.material-symbols-outlined');
      if (icon) {
        if (icon.innerText === 'favorite_border') {
          icon.innerText = 'favorite';
          icon.style.fontVariationSettings = "'FILL' 1";
          btn.classList.add('text-error');
          showToast('Offre ajoutée à tes favoris gourmands');
        } else {
          icon.innerText = 'favorite_border';
          icon.style.fontVariationSettings = "'FILL' 0";
          btn.classList.remove('text-error');
          showToast('Offre retirée des favoris');
        }
      }
    }

    function simulateGeoDetection() {
      const input = document.getElementById('postalInput');
      const btn = document.getElementById('geoBtn');
      if (btn) {
        btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin text-primary">progress_activity</span> Recherche...';
      }
      setTimeout(() => {
        if (input) input.value = "Montréal (Plateau-Mont-Royal), QC — H2W 1R7";
        if (btn) {
          btn.innerHTML = '<span class="material-symbols-outlined text-[20px] text-success-green">check</span> Détecté !';
        }
        showToast("📍 Position détectée : Plateau-Mont-Royal, Montréal");
        setTimeout(() => {
          if (btn) {
            btn.innerHTML = '<span class="material-symbols-outlined text-[20px] text-primary">my_location</span> Utiliser ma position';
          }
        }, 2500);
      }, 700);
    }

    function triggerFilterUpdate() {
      const val = document.getElementById('postalInput').value;
      showToast('Actualisation des promotions pour : ' + (val || 'Montréal'));
    }

    function setCategoryFilter(category, element) {
      document.querySelectorAll('.chip-filter').forEach(chip => {
        chip.classList.remove('bg-primary-container', 'text-on-primary', 'active-chip');
        chip.classList.add('bg-surface-card', 'text-on-surface');
      });
      element.classList.add('bg-primary-container', 'text-on-primary', 'active-chip');
      element.classList.remove('bg-surface-card', 'text-on-surface');

      const cards = document.querySelectorAll('.promo-card');
      let visibleCount = 0;
      cards.forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category || category === 'today') {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });
      showToast(visibleCount + ' promotions affichées');
    }

    function applySort(val) {
      showToast('Tri mis à jour : ' + val);
    }

    function toggleFilterModal() {
      const modal = document.getElementById('filterModal');
      if (modal) modal.classList.toggle('hidden');
    }

    function toggleRadiusModal() {
      toggleFilterModal();
    }

    function openOfferModal(resto, title, badge, code) {
      document.getElementById('modalRestaurant').innerText = resto;
      document.getElementById('modalTitle').innerText = title;
      document.getElementById('modalBadge').innerText = badge;
      document.getElementById('modalCode').innerText = code.replace('CODE: ', '');
      document.getElementById('offerModal').classList.remove('hidden');
      document.getElementById('copyBtnText').innerText = 'Copier';
    }

    function closeOfferModal() {
      document.getElementById('offerModal').classList.add('hidden');
    }

    function copyPromoCode() {
      const code = document.getElementById('modalCode').innerText;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code);
      }
      document.getElementById('copyBtnText').innerText = 'Copié !';
      showToast('Code promo ' + code + ' copié dans le presse-papiers');
    }

    function bookTableDirect() {
      closeOfferModal();
      showToast('Redirection vers le système de réservation du resto...');
    }

    function handleNewsletter(e) {
      e.preventDefault();
      const name = document.getElementById('newsletterName').value;
      const postal = document.getElementById('newsletterPostal').value;
      showToast('Merci ' + name + ' ! Ton premier Highlight resto pour ' + postal + ' arrive ce jeudi.');
      e.target.reset();
    }

    function scrollToNewsletter() {
      document.getElementById('newsletterSection').scrollIntoView({ behavior: 'smooth' });
    }

    function loadMorePromos(btn) {
      btn.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">progress_activity</span> Chargement en cours...';
      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">check</span> 12 promotions ajoutées !';
        showToast('12 promotions supplémentaires chargées');
        setTimeout(() => {
          btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">expand_more</span> Afficher les promotions suivantes';
        }, 2000);
      }, 600);
    }

    function changePage(pageNum) {
      showToast('Navigation vers la page ' + pageNum);
    }

    function selectQuickDistrict(name) {
      document.getElementById('postalInput').value = name;
      switchStateTab('main');
      showToast('Quartier sélectionné : ' + name);
    }

    function switchStateTab(state) {
      // Style buttons
      document.querySelectorAll('.state-tab-btn').forEach(btn => {
        btn.classList.remove('bg-primary', 'text-on-primary');
        btn.classList.add('bg-surface-container', 'text-on-surface');
      });
      const activeBtn = document.getElementById('stateBtn-' + state);
      if (activeBtn) {
        activeBtn.classList.add('bg-primary', 'text-on-primary');
        activeBtn.classList.remove('bg-surface-container', 'text-on-surface');
      }

      // Hide all dynamic states first
      const grid = document.getElementById('promosGrid');
      const emptyView = document.getElementById('emptyStateView');
      const deniedView = document.getElementById('geoDeniedView');
      const urgentView = document.getElementById('urgentStateView');
      const mobileSim = document.getElementById('mobileSimulationContainer');

      grid.classList.remove('hidden');
      emptyView.classList.add('hidden');
      deniedView.classList.add('hidden');
      urgentView.classList.add('hidden');
      mobileSim.classList.add('hidden');

      if (state === 'main') {
        // Default standard state
      } else if (state === 'empty') {
        grid.classList.add('hidden');
        emptyView.classList.remove('hidden');
        emptyView.classList.add('flex');
      } else if (state === 'denied') {
        grid.classList.add('hidden');
        deniedView.classList.remove('hidden');
        deniedView.classList.add('flex');
      } else if (state === 'urgent') {
        urgentView.classList.remove('hidden');
        urgentView.classList.add('flex');
        urgentView.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else if (state === 'mobileSimulation') {
        mobileSim.classList.remove('hidden');
        mobileSim.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  </script>
</div></main><footer class="w-full bg-surface-card shadow-[0_-1px_10px_rgba(0,0,0,0.03)]"><div class="max-w-[1280px] mx-auto px-margin-mobile lg:px-margin pt-space-xl pb-space-lg"><div class="flex flex-col md:flex-row items-center justify-between gap-space-lg pb-space-lg"><div class="flex flex-col items-center md:items-start gap-space-xs"><div class="flex items-center"><span class="font-headline-sm text-headline-sm text-primary tracking-tight font-extrabold">RestoEnLigne</span><span class="w-2 h-2 rounded-full bg-secondary-container ml-1"></span></div><p class="font-body-sm text-body-sm text-on-surface-variant">La destination gourmande pour dénicher les meilleures tables du Québec.</p></div><nav class="flex flex-wrap items-center justify-center md:justify-end gap-x-space-lg gap-y-space-sm" data-active-classes="text-primary font-bold"><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="a-propos" href="#">À propos</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="pour-les-restaurateurs" href="#">Pour les restaurateurs</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="contact" href="#">Contact</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="confidentialite" href="#">Confidentialité</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" data-path="conditions" href="#">Conditions</a></nav></div><div class="flex flex-col sm:flex-row items-center justify-between gap-space-sm pt-space-md bg-surface-container-low rounded-xl px-space-md py-space-sm"><div class="flex items-center gap-space-xs font-label-md text-label-md text-primary font-semibold"><span class="material-symbols-outlined text-[16px] text-secondary-container">favorite</span><span class="">Fait avec passion au Québec</span></div><p class="font-body-sm text-body-sm text-on-surface-variant">© 2025 RestoEnLigne Inc. Tous droits réservés.</p></div></div></footer>



</body></html>
