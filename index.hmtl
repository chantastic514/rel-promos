          {
            "lineHeight": "16px",
            "letterSpacing": "0.02em",
            "fontWeight": "700"
          }
        ],
        "headline-lg-mobile": [
          "26px",
          {
            "lineHeight": "34px",
            "letterSpacing": "-0.01em",
            "fontWeight": "700"
          }
        ],
        "headline-lg": [
          "32px",
          {
            "lineHeight": "40px",
            "letterSpacing": "-0.02em",
            "fontWeight": "700"
          }
        ],
        "body-sm": [
          "12px",
          {
            "lineHeight": "18px",
            "fontWeight": "400"
          }
        ],
        "label-lg": [
          "14px",
          {
            "lineHeight": "20px",
            "letterSpacing": "0.01em",
            "fontWeight": "600"
          }
        ],
        "label-sm": [
          "11px",
          {
            "lineHeight": "14px",
            "letterSpacing": "0.04em",
            "fontWeight": "700"
          }
        ],
        "display-lg": [
          "48px",
          {
            "lineHeight": "56px",
            "letterSpacing": "-0.03em",
            "fontWeight": "800"
          }
        ],
        "headline-md": [
          "24px",
          {
            "lineHeight": "32px",
            "letterSpacing": "-0.01em",
            "fontWeight": "700"
          }
        ],
        "body-md": [
          "14px",
          {
            "lineHeight": "22px",
            "fontWeight": "400"
          }
        ]
      }
    }
  }
}</script></head><body class="bg-surface-canvas font-body-md text-body-md text-on-surface antialiased"><header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface-card/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="h-20 max-w-[1280px] mx-auto px-margin-mobile lg:px-margin flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-xl"><a class="flex items-center gap-space-xs group" data-path="restaurants" href="#"><div class="flex items-center"><span class="font-headline-md text-headline-md text-primary tracking-tight font-extrabold">RestoEnLigne</span><span class="w-2.5 h-2.5 rounded-full bg-secondary-container ml-1 group-hover:scale-125 transition-transform"></span></div></a><nav class="hidden lg:flex items-center gap-space-xs" data-active-classes="bg-primary-container text-on-primary font-bold rounded-xl shadow-sm"><a class="px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="restaurants" href="#">Restaurants</a><a aria-current="page" class="px-space-md py-space-sm transition-colors bg-primary-container text-on-primary font-bold rounded-xl shadow-sm" data-path="promotions" href="#">Promotions</a><a class="px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="evenements" href="#">Événements</a><a class="px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="concours" href="#">Concours</a><a class="px-space-md py-space-sm rounded-xl font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container transition-colors" data-path="cartes-cadeaux" href="#">Cartes-cadeaux</a></nav></div><div class="flex items-center gap-space-md"><div class="hidden sm:flex items-center bg-surface-container-low rounded-full p-0.5"><button class="px-space-sm py-0.5 rounded-full font-label-sm text-label-sm bg-surface-card text-primary font-bold shadow-[0_1px_4px_rgba(0,0,0,0.06)]">FR</button><button class="px-space-sm py-0.5 rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface transition-colors">EN</button></div><button aria-label="Recherche rapide" class="w-10 h-10 rounded-full flex items-center justify-center text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors"><span class="material-symbols-outlined text-[22px]">search</span></button><a class="hidden md:inline-flex items-center font-label-md text-label-md text-primary-container hover:text-primary font-bold transition-colors" data-path="espace-restaurateur" href="#">Espace Resto</a><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="w-full pt-20 bg-surface-canvas"><div class="flex flex-col w-full">
<!-- Top Ambient Glow Decorator (contained) -->
<div class="relative w-full max-w-[1280px] mx-auto px-margin-mobile lg:px-margin">
<div class="absolute -top-10 left-1/4 w-96 h-96 bg-secondary-container/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
<div class="absolute top-20 right-10 w-80 h-80 bg-primary-container/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
<!-- 1. HERO COMPACT & GÉOLOCALISATION IMMÉDIATE -->
<section class="pt-space-lg pb-space-lg w-full flex flex-col gap-space-md">
<div class="flex flex-col max-w-3xl">
<div class="inline-flex items-center gap-space-xs self-start px-space-sm py-1 rounded-full bg-surface-container text-primary font-label-sm text-label-sm uppercase tracking-wider mb-space-xs">
<span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
          Offres en temps réel au Québec
        </div>
<h1 class="font-display-lg text-display-lg-mobile lg:text-display-lg text-on-surface tracking-tight">
          Les meilleures promotions de restaurants <span class="text-primary font-extrabold underline decoration-secondary-container decoration-4 underline-offset-4">près de chez toi</span>
</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant mt-space-xs">
          Découvre les rabais, menus spéciaux et offres à durée limitée disponibles dans les restos de ta région.
        </p>
</div>
<!-- Geo Search Box -->
<div class="w-full bg-surface-card rounded-xl p-space-md shadow-md flex flex-col gap-space-sm">
<form class="flex flex-col md:flex-row items-stretch md:items-center gap-space-sm" id="geoForm" onsubmit="event.preventDefault(); triggerFilterUpdate();">
<div class="relative flex-1 flex items-center bg-surface-container-low rounded-xl px-space-md py-space-sm">
<span class="material-symbols-outlined text-primary text-[22px] mr-space-xs">location_on</span>
<div class="flex flex-col flex-1 min-w-0">
<label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider" for="postalInput">Localisation cible</label>
<input class="bg-transparent font-title-md text-title-md text-on-surface font-semibold focus:outline-none placeholder:text-outline" id="postalInput" placeholder="Ville ou code postal (ex: H2X 1Y4)" type="text" value="Montréal, QC — H2X 1Y4">
</div>
<button class="text-on-surface-variant hover:text-on-surface p-1 rounded-full hover:bg-surface-container" onclick="document.getElementById('postalInput').value='Montréal, QC — H2X 1Y4'; showToast('Position réinitialisée à Montréal');" title="Effacer" type="button">
<span class="material-symbols-outlined text-[18px]">close</span>
</button>
</div>
<div class="flex items-center gap-space-sm">
<button class="px-space-md py-space-md rounded-xl font-label-lg text-label-lg text-primary font-bold hover:bg-surface-container flex items-center gap-space-xs transition-colors" id="geoBtn" onclick="simulateGeoDetection();" type="button">
<span class="material-symbols-outlined text-[20px] text-primary">my_location</span>
<span class="">Utiliser ma position</span>
</button>
<button class="px-space-xl py-space-md rounded-xl font-label-lg text-label-lg bg-secondary-container text-on-primary font-bold shadow-sm hover:opacity-95 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-space-xs" type="submit">
<span class="">Voir les offres</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</div>
</form>
<!-- Active Geo Radius Pill -->
<div class="flex flex-wrap items-center justify-between gap-space-xs pt-space-xs">
<div class="inline-flex items-center gap-space-xs font-label-md text-label-md text-on-surface-variant">
<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-bold text-[12px]">📍</span>
<span class="">Promotions sélectionnées près de <strong class="text-on-surface">Montréal — H2X 1Y4</strong></span>
<span class="inline-block px-space-xs py-0.5 rounded-md bg-surface-container text-primary font-bold text-label-sm">Rayon : 10 km</span>
</div>
<div class="flex items-center gap-space-sm">
<button class="font-label-md text-label-md text-primary font-bold hover:underline inline-flex items-center gap-1" onclick="toggleRadiusModal();" type="button">
<span class="material-symbols-outlined text-[16px]">tune</span>
<span class="">Modifier le rayon</span>
</button>
</div>
</div>
</div>
</section>
<!-- 2. BARRE DE FILTRES RAPIDES (CHIPS) & TRI -->
<section class="py-space-sm flex flex-col gap-space-sm">
<div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
<!-- Quick Filter Scrollable Chips -->
<div class="flex items-center gap-space-xs overflow-x-auto pb-1 max-w-full">
<button class="chip-filter active-chip whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all flex items-center gap-space-xs bg-primary-container text-on-primary font-bold shadow-sm" onclick="setCategoryFilter('all', this)">
<span class="">Tous</span>
<span class="px-1.5 py-0.5 text-[11px] rounded-full bg-on-primary/20 text-on-primary font-bold">48</span>
</button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all flex items-center gap-space-xs bg-surface-card text-on-surface hover:bg-surface-container font-semibold" onclick="setCategoryFilter('today', this)">
<span class="material-symbols-outlined text-[16px] text-secondary-container">local_fire_department</span>
<span class="">Aujourd'hui</span>
<span class="w-2 h-2 rounded-full bg-success-green"></span>
</button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all bg-surface-card text-on-surface hover:bg-surface-container font-semibold" onclick="setCategoryFilter('week', this)">
            Cette semaine
          </button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all bg-surface-card text-on-surface hover:bg-surface-container font-semibold" onclick="setCategoryFilter('2for1', this)">
            2 pour 1
          </button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all bg-surface-card text-on-surface hover:bg-surface-container font-semibold" onclick="setCategoryFilter('under20', this)">
            Moins de 20 $
          </button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all bg-surface-card text-on-surface hover:bg-surface-container font-semibold" onclick="setCategoryFilter('freebie', this)">
            Gratuités
          </button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all bg-surface-card text-on-surface hover:bg-surface-container font-semibold" onclick="setCategoryFilter('lunch', this)">
            Menus du midi
          </button>
<button class="chip-filter whitespace-nowrap px-space-md py-space-xs rounded-full font-label-lg text-label-lg transition-all flex items-center gap-space-xs bg-surface-card text-primary font-bold hover:bg-surface-container" onclick="setCategoryFilter('exclusive', this)">
<span class="material-symbols-outlined text-[16px] text-tertiary-fixed-dim" style="font-variation-settings: 'FILL' 1;">stars</span>
<span class="">Offres exclusives REL</span>
</button>
</div>
<!-- Controls: All Filters modal button + Sort dropdown -->
<div class="flex items-center justify-between lg:justify-end gap-space-sm min-w-max">
<button class="px-space-md py-space-xs rounded-xl font-label-lg text-label-lg bg-surface-card text-primary hover:bg-surface-container font-bold shadow-sm flex items-center gap-space-xs" onclick="toggleFilterModal()" type="button">
<span class="material-symbols-outlined text-[18px]">tune</span>
<span class="">Tous les filtres</span>
<span class="w-5 h-5 rounded-full bg-primary-container text-on-primary text-[11px] flex items-center justify-center font-bold">3</span>
</button>
<div class="relative flex items-center bg-surface-card rounded-xl px-space-md py-space-xs shadow-sm">
<span class="font-label-sm text-label-sm text-on-surface-variant mr-1">Trier par :</span>
<select class="bg-transparent font-label-lg text-label-lg text-on-surface font-bold focus:outline-none cursor-pointer pr-space-xs" id="sortSelect" onchange="applySort(this.value)">
<option value="recommended">Recommandées pour moi</option>
<option value="nearest">Les plus proches</option>
<option value="expiring">Expirent bientôt</option>
<option value="recent">Les plus récentes</option>
<option value="savings">Meilleures économies</option>
</select>
</div>
</div>
</div>
</section>
<!-- 3. SECTION « À NE PAS MANQUER PRÈS DE MONTRÉAL » (3 PROMOTIONS VEDETTES) -->
<section class="pt-space-lg pb-space-lg">
<div class="flex items-end justify-between mb-space-md">
<div>
<div class="flex items-center gap-space-xs text-secondary font-label-sm text-label-sm uppercase tracking-wider font-extrabold">
<span class="material-symbols-outlined text-[18px]">verified</span>
            Sélection premium du chef
          </div>
<h2 class="font-headline-lg text-headline-lg-mobile lg:text-headline-lg text-on-surface tracking-tight">
            À ne pas manquer près de Montréal
          </h2>
</div>
<span class="hidden sm:inline-flex font-label-md text-label-md text-on-surface-variant font-medium">
          3 offres coup de cœur en vedette
        </span>
</div>
<!-- Bento Featured Trio Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-md">
<!-- VEDETTE 1: Kinton Ramen 2 pour 1 -->
<article class="group bg-surface-card rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
<div class="relative w-full aspect-video overflow-hidden">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="A steaming hot artisan ramen bowl with tender chashu pork, rich creamy broth, soft-boiled ajitsuke tamago, fresh scallions and nori in an authentic Montreal Plateau Japanese bistro ambiance with soft warm lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCge7DAGmbON46sjYCv1dUNg9axNQdFd0DLi881QxdhnzaasXZd0rVB9lN54F-6F5TPfX4jRw2MpxQrwlmDVZma5GU37m6dWVcHD1L9DiDB31EZZUC-xzm2NonWKPHSGTiSCtj6QYz784ZnxkrootAUlSYxB-KCHoDprTReg-X2w-KZfhYXNmryXZeyiWDLP5j6phW6npZUgUnhDudp5SNnPEHxsJe225rLdg6bmddFu764tDN1KYMkgQ">
<!-- Discount Badge -->
<div class="absolute top-space-sm left-space-sm flex flex-col gap-1 items-start">
<span class="px-space-sm py-1 rounded-md bg-secondary-container text-on-primary font-display-lg text-[22px] font-extrabold tracking-tight shadow-md leading-none">
                2 POUR 1
              </span>
<span class="px-space-xs py-0.5 rounded-md bg-promo-exclusive text-on-primary font-label-sm text-label-sm font-bold flex items-center gap-1 shadow-sm">
<span class="material-symbols-outlined text-[14px]">star</span> Exclusivité REL
              </span>
</div>
<!-- Favorite button -->
<button aria-label="Favori" class="absolute top-space-sm right-space-sm w-9 h-9 rounded-full bg-surface-card/90 backdrop-blur-md text-on-surface-variant hover:text-error flex items-center justify-center shadow-sm transition-transform active:scale-90" onclick="toggleFav(this)">
<span class="material-symbols-outlined text-[20px]">favorite_border</span>
</button>
<!-- Urgency pill bottom of photo -->
<div class="absolute bottom-space-xs left-space-sm px-space-sm py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-bold flex items-center gap-1">
<span class="material-symbols-outlined text-[14px] text-promo-urgent">timer</span>
<span class="">Expire ce dimanche (27 sept.)</span>
</div>
</div>
<div class="p-space-md flex-1 flex flex-col justify-between gap-space-md">
<div>
<div class="flex items-center justify-between gap-space-xs mb-space-xs">
<span class="font-label-md text-label-md text-on-surface-variant font-semibold">Restaurant Kinton Ramen</span>
<span class="font-label-sm text-label-sm text-primary font-bold bg-surface-container px-2 py-0.5 rounded-md">Montréal (Plateau) · 1,2 km</span>
</div>
<h3 class="font-headline-sm text-headline-sm text-on-surface font-extrabold tracking-tight group-hover:text-primary transition-colors">
                Deux ramens Signature pour le prix d'un
              </h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">
                Valable sur les bols Shoyu, Miso et Piquant avec tout achat de boisson maison.
              </p>
<div class="flex flex-wrap gap-space-xs mt-space-sm">
<span class="px-space-xs py-0.5 rounded-md bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm font-medium">Sur place</span>
<span class="px-space-xs py-0.5 rounded-md bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm font-medium">Spécial dîner &amp; souper</span>
</div>
</div>
<div class="pt-space-sm flex items-center justify-between gap-space-sm">
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-on-surface-variant line-through">Valeur 39,90 $</span>
<span class="font-title-md text-title-md text-secondary font-extrabold">19,95 $ <span class="font-body-sm text-body-sm font-normal text-on-surface-variant">total</span></span>
</div>
<button class="px-space-lg py-space-sm rounded-xl font-label-lg text-label-lg bg-secondary-container text-on-primary font-bold hover:opacity-95 shadow-sm transition-all" onclick="openOfferModal('Kinton Ramen', 'Deux ramens Signature pour le prix d\'un', '2 POUR 1', 'CODE: KINTON2X1')">
                Voir l'offre
              </button>
</div>
</div>
