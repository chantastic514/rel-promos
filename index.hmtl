        "on-primary-fixed": "#2d004f",
        "inverse-primary": "#dfb7ff",
        "promo-exclusive": "#491D6E",
        "on-secondary": "#ffffff",
        "outline-variant": "#cec3d2",
        "error-container": "#ffdad6",
        "secondary-fixed": "#ffdbd0",
        "secondary": "#ae3100",
        "promo-urgent": "#D92D20",
        "primary-fixed": "#f1daff",
        "tertiary": "#3d2900",
        "on-error": "#ffffff",
        "surface-container-high": "#efe5f3",
        "surface-bright": "#fff7ff",
        "primary": "#460175",
        "tertiary-fixed": "#ffdea8",
        "on-surface": "#1e1a23",
        "primary-container": "#5e258d",
        "on-tertiary-fixed": "#271900",
        "surface-variant": "#e9dfed",
        "surface-container-low": "#faf0fe",
        "on-secondary-container": "#5b1500",
        "on-primary": "#ffffff",
        "surface-card": "#FFFFFF",
        "on-tertiary-container": "#e4a400",
        "background": "#fff7ff",
        "tertiary-container": "#593e00",
        "surface-container-highest": "#e9dfed",
        "primary-fixed-dim": "#dfb7ff"
      },
      "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
      },
      "spacing": {
        "space-sm": "0.5rem",
        "space-xs": "0.25rem",
        "space-xl": "2.5rem",
        "gutter-mobile": "1rem",
        "margin": "2rem",
        "space-lg": "1.5rem",
        "margin-mobile": "1rem",
        "space-md": "1rem",
        "gutter": "1.25rem"
      },
      "fontFamily": {
        "headline-sm": [
          "Plus Jakarta Sans"
        ],
        "title-md": [
          "Plus Jakarta Sans"
        ],
        "display-lg-mobile": [
          "Plus Jakarta Sans"
        ],
        "body-lg": [
          "Plus Jakarta Sans"
        ],
        "label-md": [
          "Plus Jakarta Sans"
        ],
        "headline-lg-mobile": [
          "Plus Jakarta Sans"
        ],
        "headline-lg": [
          "Plus Jakarta Sans"
        ],
        "body-sm": [
          "Plus Jakarta Sans"
        ],
        "label-lg": [
          "Plus Jakarta Sans"
        ],
        "label-sm": [
          "Plus Jakarta Sans"
        ],
        "display-lg": [
          "Plus Jakarta Sans"
        ],
        "headline-md": [
          "Plus Jakarta Sans"
        ],
        "body-md": [
          "Plus Jakarta Sans"
        ]
      },
      "fontSize": {
        "headline-sm": [
          "20px",
          {
            "lineHeight": "28px",
            "fontWeight": "600"
          }
        ],
        "title-md": [
          "18px",
          {
            "lineHeight": "26px",
            "fontWeight": "600"
          }
        ],
        "display-lg-mobile": [
          "34px",
          {
            "lineHeight": "42px",
            "letterSpacing": "-0.02em",
            "fontWeight": "800"
          }
        ],
        "body-lg": [
          "16px",
          {
